{% comment %} twinfold — self-contained branded policy template (all policies). {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">

<style>
  .tf-policy{ background:#FCFBF7; }
  .tf-policy__inner{ max-width:760px; margin:0 auto; padding:56px 24px 104px; }

  .tf-policy__nav{ display:flex; flex-wrap:wrap; gap:8px 22px; padding-bottom:22px; margin-bottom:44px; border-bottom:1px solid #e4e2da; }
  .tf-policy__navlink{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-size:13px; font-weight:500; letter-spacing:.01em; color:#7a7a70; text-decoration:none; transition:color .15s ease; }
  .tf-policy__navlink:hover{ color:#3a4a3a; }
  .tf-policy__navlink.is-active{ color:#2f4030; font-weight:600; }

  .tf-policy__eyebrow{ display:block; font-family:'Hanken Grotesk',system-ui,sans-serif; font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:#5f7a5f; margin-bottom:14px; }
  .tf-policy__title{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-weight:600; font-size:clamp(36px,6vw,52px); line-height:1.08; letter-spacing:-.015em; color:#2b2c33; margin:0 0 44px; }

  .tf-policy__body{ font-family:'Newsreader',Georgia,'Times New Roman',serif; font-size:19px; line-height:1.8; color:#43434e; }
  .tf-policy__body h1, .tf-policy__body h2, .tf-policy__body h3{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-weight:600; line-height:1.25; letter-spacing:-.01em; color:#2b2c33; margin:52px 0 14px; }
  .tf-policy__body h1{ font-size:30px; }
  .tf-policy__body h2{ font-size:26px; }
  .tf-policy__body h3{ font-size:22px; }
  .tf-policy__body > :first-child{ margin-top:0; }
  .tf-policy__body p{ margin:0 0 20px; font-size:19px; line-height:1.8; color:#43434e; }
  .tf-policy__body ul, .tf-policy__body ol{ margin:0 0 22px; padding-left:1.35em; }
  .tf-policy__body li{ margin:9px 0; font-size:19px; line-height:1.7; }
  .tf-policy__body a{ color:#3f7a50; text-decoration:underline; text-underline-offset:2px; }
  .tf-policy__body a:hover{ color:#2f5c3c; }
  .tf-policy__body strong{ font-weight:600; color:#33343c; }

  @media(max-width:749px){
    .tf-policy__inner{ padding:36px 20px 72px; }
    .tf-policy__body, .tf-policy__body p, .tf-policy__body li{ font-size:18px; }
  }
</style>

<section class="tf-policy">
  <div class="tf-policy__inner">
    <nav class="tf-policy__nav" aria-label="Policies">
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}" class="tf-policy__navlink{% if policy.title == page.title %} is-active{% endif %}"{% if policy.title == page.title %} aria-current="page"{% endif %}>{{ policy.title }}</a>
      {%- endfor -%}
    </nav>
    <header class="tf-policy__head">
      <span class="tf-policy__eyebrow">twinfold</span>
      <h1 class="tf-policy__title">{{ page.title }}</h1>
    </header>
    <div class="tf-policy__body rte">
      {{ page.content }}
    </div>
  </div>
</section>
