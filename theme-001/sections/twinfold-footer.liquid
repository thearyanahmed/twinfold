<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .tf-footer{
    --paper:oklch(0.988 0.005 95);--ink:oklch(0.24 0.01 260);--band:oklch(0.965 0.014 145);
    --muted:oklch(0.4 0.008 260);--meta:oklch(0.5 0.01 250);--accent:oklch(0.45 0.05 150);
    --line:oklch(0.85 0.015 145);--btn:oklch(0.24 0.02 150);
    background:var(--band);font-family:'Hanken Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased;color:var(--ink);
    padding:72px 56px 40px;
  }
  .tf-footer *{box-sizing:border-box;margin:0;padding:0;}
  .tf-footer a{color:inherit;text-decoration:none;}
  .tf-footer .tf-ft-navlink{transition:color .2s ease;}
  .tf-footer .tf-ft-navlink:hover{color:var(--accent);}
  .tf-footer .tf-ft-cols{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;}
  .tf-footer .tf-ft-brand-name{font-weight:600;font-size:22px;letter-spacing:-.01em;margin-bottom:14px;}
  .tf-footer .tf-ft-brand-line{font-family:'Newsreader',serif;font-size:17px;line-height:1.5;color:var(--muted);max-width:300px;margin-bottom:22px;}
  .tf-footer .tf-ft-socials{display:flex;gap:10px;}
  .tf-footer .tf-ft-social{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);color:oklch(0.4 0.01 260);display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;transition:border-color .2s,color .2s;}
  .tf-footer .tf-ft-social:hover{border-color:oklch(0.6 0.03 150);color:var(--accent);}
  .tf-footer .tf-ft-head{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--meta);margin-bottom:16px;}
  .tf-footer .tf-ft-links{display:flex;flex-direction:column;gap:10px;}
  .tf-footer .tf-ft-links a{font-size:14.5px;color:oklch(0.36 0.01 260);}
  .tf-footer .tf-ft-signup-row{max-width:1280px;margin:56px auto 0;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;}
  .tf-footer .tf-ft-signup{max-width:360px;}
  .tf-footer .tf-ft-form{display:flex;gap:8px;margin-top:2px;}
  .tf-footer .tf-ft-form input{flex:1;font-family:'Hanken Grotesk';font-size:14px;color:oklch(0.28 0.01 260);background:oklch(0.99 0.003 95);border:1px solid var(--line);border-radius:100px;padding:11px 18px;outline:none;}
  .tf-footer .tf-ft-form button{font-size:14px;font-weight:500;color:oklch(0.98 0 0);background:var(--btn);border:none;border-radius:100px;padding:11px 22px;cursor:pointer;}
  .tf-footer .tf-ft-note{font-size:13px;color:var(--accent);margin-top:10px;}
  .tf-footer .tf-ft-made{font-size:13px;color:var(--meta);text-align:right;}
  .tf-footer .tf-ft-legal{max-width:1280px;margin:40px auto 0;display:flex;flex-wrap:wrap;gap:16px 28px;justify-content:space-between;font-size:12.5px;color:oklch(0.55 0.01 250);}
  .tf-footer .tf-ft-legal .tf-ft-legal-links{display:flex;flex-wrap:wrap;gap:24px;}
  @media(max-width:820px){
    .tf-footer{padding:56px 24px 32px;}
    .tf-footer .tf-ft-cols{grid-template-columns:1fr 1fr;}
    .tf-footer .tf-ft-signup-row{grid-template-columns:1fr;}
    .tf-footer .tf-ft-made{text-align:left;}
  }
</style>

{%- liquid
  assign s = section.settings
  assign shop_list = linklists[s.shop_menu]
  assign company_list = linklists[s.company_menu]
  assign help_list = linklists[s.help_menu]
-%}

<div class="tf-footer">
  <div class="tf-ft-cols">
    <div>
      <div class="tf-ft-brand-name">{{ s.brand_name }}</div>
      <p class="tf-ft-brand-line">{{ s.brand_line }}</p>
      <div class="tf-ft-socials">
        {%- if s.instagram_url != blank -%}<a class="tf-ft-social" href="{{ s.instagram_url }}" aria-label="Instagram">IG</a>{%- endif -%}
        {%- if s.facebook_url != blank -%}<a class="tf-ft-social" href="{{ s.facebook_url }}" aria-label="Facebook">FB</a>{%- endif -%}
        {%- if s.pinterest_url != blank -%}<a class="tf-ft-social" href="{{ s.pinterest_url }}" aria-label="Pinterest">PT</a>{%- endif -%}
        {%- if s.tiktok_url != blank -%}<a class="tf-ft-social" href="{{ s.tiktok_url }}" aria-label="TikTok">TT</a>{%- endif -%}
        {%- if s.twitter_url != blank -%}<a class="tf-ft-social" href="{{ s.twitter_url }}" aria-label="X">X</a>{%- endif -%}
      </div>
    </div>

    {%- if shop_list.links.size > 0 -%}
    <div>
      <div class="tf-ft-head">{{ s.shop_heading }}</div>
      <div class="tf-ft-links">
        {%- for link in shop_list.links -%}<a class="tf-ft-navlink" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- if company_list.links.size > 0 -%}
    <div>
      <div class="tf-ft-head">{{ s.company_heading }}</div>
      <div class="tf-ft-links">
        {%- for link in company_list.links -%}<a class="tf-ft-navlink" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- if help_list.links.size > 0 -%}
    <div>
      <div class="tf-ft-head">{{ s.help_heading }}</div>
      <div class="tf-ft-links">
        {%- for link in help_list.links -%}<a class="tf-ft-navlink" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    </div>
    {%- endif -%}
  </div>

  <div class="tf-ft-signup-row">
    <div class="tf-ft-signup">
      <div class="tf-ft-head">{{ s.newsletter_heading }}</div>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="tf-ft-form">
          <input type="email" name="contact[email]" placeholder="{{ s.newsletter_placeholder }}" required>
          <button type="submit" name="commit">{{ s.newsletter_button }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p class="tf-ft-note">{{ s.newsletter_success }}</p>{%- endif -%}
      {%- endform -%}
    </div>
    {%- if s.made_text != blank -%}<div class="tf-ft-made">{{ s.made_text }}</div>{%- endif -%}
  </div>

  <div class="tf-ft-legal">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <div class="tf-ft-legal-links">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a class="tf-ft-navlink" href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Twinfold footer",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "twinfold" },
    { "type": "textarea", "id": "brand_line", "label": "Brand line", "default": "Considered objects for a calm, analog life — in rhythm with the day and the season." },
    { "type": "header", "content": "Columns (choose menus in Navigation)" },
    { "type": "text", "id": "shop_heading", "label": "Column 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Column 1 menu" },
    { "type": "text", "id": "company_heading", "label": "Column 2 heading", "default": "Company" },
    { "type": "link_list", "id": "company_menu", "label": "Column 2 menu" },
    { "type": "text", "id": "help_heading", "label": "Column 3 heading", "default": "Help" },
    { "type": "link_list", "id": "help_menu", "label": "Column 3 menu" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "The quiet note" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Input placeholder", "default": "you@email.com" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Join" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thank you — you’re on the list." },
    { "type": "text", "id": "made_text", "label": "Made-by line", "default": "Packed & sent by hand in the UK" },
    { "type": "header", "content": "Social links (leave blank to hide)" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "twitter_url", "label": "X / Twitter" }
  ]
}
{% endschema %}
