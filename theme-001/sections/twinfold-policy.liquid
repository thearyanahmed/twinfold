{% comment %} twinfold — branded, consistent policy page template. Renders all shop policies (Privacy, Refund, Terms, Contact, Shipping) with one style. {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">

<section class="tf-policy">
  <div class="tf-policy__inner">

    {%- if section.settings.show_policy_nav -%}
      <nav class="tf-policy__nav" aria-label="Policies">
        {%- for policy in shop.policies -%}
          <a
            href="{{ policy.url }}"
            class="tf-policy__navlink{% if policy.title == page.title %} is-active{% endif %}"
            {% if policy.title == page.title %}aria-current="page"{% endif %}
          >{{ policy.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <header class="tf-policy__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tf-policy__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="tf-policy__title">{{ page.title }}</h1>
    </header>

    <div class="tf-policy__body">
      {{ page.content }}
    </div>

  </div>
</section>

{% stylesheet %}
  .tf-policy{
    background:#FCFBF7;
    padding:0;
  }
  .tf-policy__inner{
    max-width:760px;
    margin:0 auto;
    padding:56px 24px 104px;
  }

  /* policy nav */
  .tf-policy__nav{
    display:flex;
    flex-wrap:wrap;
    gap:8px 22px;
    padding-bottom:22px;
    margin-bottom:44px;
    border-bottom:1px solid oklch(0.9 0.01 250);
  }
  .tf-policy__navlink{
    font-family:'Hanken Grotesk',system-ui,sans-serif;
    font-size:13px;
    font-weight:500;
    letter-spacing:.01em;
    color:oklch(0.55 0.02 250);
    text-decoration:none;
    transition:color .15s ease;
  }
  .tf-policy__navlink:hover{ color:oklch(0.3 0.02 150); }
  .tf-policy__navlink.is-active{ color:oklch(0.28 0.03 150); font-weight:600; }

  /* header */
  .tf-policy__eyebrow{
    display:block;
    font-family:'Hanken Grotesk',system-ui,sans-serif;
    font-size:12px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:oklch(0.5 0.03 150);
    margin-bottom:14px;
  }
  .tf-policy__title{
    font-family:'Hanken Grotesk',system-ui,sans-serif !important;
    font-weight:600;
    font-size:clamp(36px,6vw,52px);
    line-height:1.08;
    letter-spacing:-.015em;
    color:oklch(0.24 0.02 260);
    margin:0 0 44px;
  }

  /* body — normalises every policy's markup into one style */
  .tf-policy .tf-policy__body{
    font-family:'Newsreader',Georgia,'Times New Roman',serif;
    font-size:19px;
    line-height:1.8;
    color:oklch(0.34 0.01 260);
  }
  .tf-policy .tf-policy__body h1,
  .tf-policy .tf-policy__body h2,
  .tf-policy .tf-policy__body h3{
    font-family:'Hanken Grotesk',system-ui,sans-serif !important;
    font-weight:600 !important;
    line-height:1.25;
    letter-spacing:-.01em;
    color:oklch(0.24 0.02 260);
    margin:52px 0 14px;
  }
  .tf-policy .tf-policy__body h1{ font-size:30px !important; }
  .tf-policy .tf-policy__body h2{ font-size:26px !important; }
  .tf-policy .tf-policy__body h3{ font-size:22px !important; }
  .tf-policy .tf-policy__body > :first-child{ margin-top:0; }
  .tf-policy .tf-policy__body p{
    margin:0 0 20px;
    font-size:19px !important;
    line-height:1.8;
    color:oklch(0.34 0.01 260);
  }
  .tf-policy .tf-policy__body ul,
  .tf-policy .tf-policy__body ol{
    margin:0 0 22px;
    padding-left:1.35em;
  }
  .tf-policy .tf-policy__body li{
    margin:9px 0;
    font-size:19px !important;
    line-height:1.7;
  }
  .tf-policy .tf-policy__body a{
    color:oklch(0.42 0.06 150);
    text-decoration:underline;
    text-underline-offset:2px;
    text-decoration-thickness:1px;
  }
  .tf-policy .tf-policy__body a:hover{ color:oklch(0.32 0.05 150); }
  .tf-policy .tf-policy__body strong{ font-weight:600; color:oklch(0.28 0.01 260); }

  @media(max-width:749px){
    .tf-policy__inner{ padding:36px 20px 72px; }
    .tf-policy .tf-policy__body{ font-size:18px; }
    .tf-policy .tf-policy__body p,
    .tf-policy .tf-policy__body li{ font-size:18px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_policy_nav",
      "label": "Show links to other policies",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "twinfold"
    }
  ]
}
{% endschema %}
