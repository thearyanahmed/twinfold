{% doc %}
  @prompt
    I want to display all the collection's all the products. So for all collections, show all products in grid. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-all-collections-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-all-collections-grid__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-all-collections-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-all-collections-grid__collection-section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.collection_spacing }}px;
  }

  .ai-all-collections-grid__collection-title-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.collection_title_color }};
    font-size: {{ block.settings.collection_title_size }}px;
    text-align: {{ block.settings.collection_title_alignment }};
  }

  .ai-all-collections-grid__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 40px;
  }

  .ai-all-collections-grid__product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-all-collections-grid__product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-all-collections-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background_color }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-all-collections-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-all-collections-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-all-collections-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-all-collections-grid__product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px 0;
    text-align: {{ block.settings.product_info_alignment }};
  }

  .ai-all-collections-grid__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin-bottom: 8px;
    color: {{ block.settings.product_title_color }};
  }

  .ai-all-collections-grid__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-all-collections-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-all-collections-grid__empty-state-{{ ai_gen_id }} h3 {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .ai-all-collections-grid__empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-all-collections-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-all-collections-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-all-collections-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-all-collections-grid__collection-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.collection_title_size }}px * 0.8);
    }
  }
{% endstyle %}

<all-collections-grid-{{ ai_gen_id }} class="ai-all-collections-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-all-collections-grid__container-{{ ai_gen_id }}">
    {% if block.settings.main_heading != blank %}
      <h2 class="ai-all-collections-grid__heading-{{ ai_gen_id }}">
        {{ block.settings.main_heading }}
      </h2>
    {% endif %}

    {% assign has_products = false %}
    
    {% for collection in collections %}
      {% if collection.products.size > 0 %}
        {% assign has_products = true %}
        <div class="ai-all-collections-grid__collection-section-{{ ai_gen_id }}">
          {% if block.settings.show_collection_titles %}
            <h3 class="ai-all-collections-grid__collection-title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
          {% endif %}

          <div class="ai-all-collections-grid__products-{{ ai_gen_id }}">
            {% for product in collection.products limit: block.settings.products_per_collection %}
              <a 
                href="{{ product.url }}" 
                class="ai-all-collections-grid__product-card-{{ ai_gen_id }}"
              >
                <div class="ai-all-collections-grid__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                      class="ai-all-collections-grid__image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-all-collections-grid__placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-all-collections-grid__product-info-{{ ai_gen_id }}">
                  <h4 class="ai-all-collections-grid__product-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h4>
                  <div class="ai-all-collections-grid__product-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% unless has_products %}
      <div class="ai-all-collections-grid__empty-state-{{ ai_gen_id }}">
        <h3>No products found</h3>
        <p>Add products to your collections to display them here.</p>
      </div>
    {% endunless %}
  </div>
</all-collections-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class AllCollectionsGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const productCards = this.querySelectorAll('.ai-all-collections-grid__product-card-{{ ai_gen_id }}');
        
        productCards.forEach(card => {
          card.addEventListener('click', function(e) {
            const url = this.getAttribute('href');
            if (url) {
              window.location.href = url;
            }
          });
        });
      }
    }

    customElements.define('all-collections-grid-{{ ai_gen_id }}', AllCollectionsGrid{{ ai_gen_id }});
  })();
</script>

